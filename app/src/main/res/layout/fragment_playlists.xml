<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/playlists_fragment_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_playlists"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/refreshButton"
        android:paddingEnd="8dp"
        android:paddingStart="8dp"
        android:paddingTop="16dp"
        android:clipToPadding="false"/>

    <TextView
        android:id="@+id/refreshButton"
        style="@style/refresh_fragment_style"
        android:text="Новый плейлист"
        app:layout_constraintBottom_toTopOf="@+id/image_placeholder_playlists"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginBottom="46dp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toTopOf="parent"/>

    <ImageView
        android:id="@+id/image_placeholder_playlists"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/error_search"
        android:visibility="visible"
        app:layout_constraintBottom_toTopOf="@+id/text_placeholder_playlists"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="106dp"/>

    <TextView
        android:id="@+id/text_placeholder_playlists"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Вы не создали\nни одного плейлиста"
        style="@style/error_fragment_text_style"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@id/image_placeholder_playlists"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>